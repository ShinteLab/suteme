# バイナリ
*.exe
*.dll
*.so

# デバッグ画像（自動生成）
debug_*.png

# 学習済みモデル・学習データ（大きい / 機密性あり）
model*.json
training_data*.bin
training_data*.bin.tmp*
training_data*.json
training_data.json.*

# 盤の縁の帯（1マス滑りの判定器）。history.json から作り直せる生成物なので
# training_data*.bin と同じ扱い（training/unslip.go の rebuildStripData）
strip_data*.bin
strip_data*.bin.tmp*

# 向き照合データ（配布用の間引き）。学習データの部分集合なので同じ扱い
orient_data*.bin
orient_data*.bin.tmp*

# 保存済み局面データ
data/

# 配布用の書き出し（training/compact.go。学習データから作り直せる）
dist/

# Go ビルドキャッシュ
/vendor/
